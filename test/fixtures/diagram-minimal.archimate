<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Minimal" id="model-minimal" version="5.0.0">
  <folder name="Application" id="folder-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Source" id="element-source"/>
    <element xsi:type="archimate:ApplicationComponent" name="Target" id="element-target"/>
    <element xsi:type="archimate:ApplicationComponent" name="Nested" id="element-nested">
      <documentation>nested</documentation>
    </element>
  </folder>
  <folder name="Relations" id="folder-rel" type="relations">
    <element xsi:type="archimate:ServingRelationship" id="rel-empty" source="element-source" target="element-target"/>
    <element xsi:type="archimate:ServingRelationship" id="rel-bend" source="element-source" target="element-target"/>
  </folder>
  <folder name="Views" id="folder-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" name="Minimal View" id="view-minimal">
      <child xsi:type="archimate:DiagramObject" id="vis-source" archimateElement="element-source">
        <bounds x="10" y="20" width="100" height="50"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-empty" source="vis-source" target="vis-target" archimateRelationship="rel-empty"/>
        <sourceConnection xsi:type="archimate:Connection" id="conn-bend" source="vis-source" target="vis-target" archimateRelationship="rel-bend">
          <bendpoint startX="25" startY="5" endX="40" endY="10"/>
        </sourceConnection>
        <child xsi:type="archimate:DiagramObject" id="vis-nested" archimateElement="element-nested">
          <bounds x="5" y="8" width="30" height="12"/>
        </child>
      </child>
      <child xsi:type="archimate:DiagramObject" id="vis-target" archimateElement="element-target">
        <bounds x="200" y="30" width="90" height="40"/>
      </child>
      <child xsi:type="archimate:Note" id="note-1">
        <bounds x="15" y="90" width="50" height="20"/>
        <content>note</content>
      </child>
    </element>
  </folder>
</archimate:model>
