<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Object Details" id="model-object-details" version="5.0.0">
  <purpose>Model purpose&#xD;&#xA;Second line</purpose>
  <property key="ModelOwner" value="Architecture Team"/>
  <folder name="Application" id="folder-app" type="application">
    <documentation>Application folder documentation</documentation>
    <property key="FolderOwner" value="App Team"/>
    <element xsi:type="archimate:ApplicationComponent" name="Shared Component" id="element-shared">
      <documentation>Shared component documentation&#xD;&#xA;Second line</documentation>
      <property key="First" value="One"/>
      <property key="Second" value="Two"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="No Properties" id="element-empty"/>
  </folder>
  <folder name="Other" id="folder-other" type="other">
    <element xsi:type="archimate:Grouping" name="Semantic Grouping" id="element-grouping"/>
  </folder>
  <folder name="Relations" id="folder-rel" type="relations">
    <element xsi:type="archimate:ServingRelationship" name="serves" id="relationship-serving" source="element-shared" target="element-empty">
      <documentation>Relationship documentation</documentation>
      <property key="Order" value="1"/>
    </element>
  </folder>
  <folder name="Views" id="folder-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" name="Details View" id="view-details" viewpoint="layered" connectionRouterType="2">
      <child xsi:type="archimate:DiagramModelReference" id="visual-modelref" model="view-other">
        <bounds x="350" y="140" width="120" height="60"/>
      </child>
      <child xsi:type="archimate:Group" id="visual-group" name="Visual Group" textAlignment="1">
        <bounds x="10" y="10" width="420" height="220"/>
        <documentation>Visual group documentation</documentation>
        <child xsi:type="archimate:DiagramObject" id="visual-nested-in-group" archimateElement="element-empty">
          <bounds x="30" y="160" width="120" height="40"/>
        </child>
      </child>
      <child xsi:type="archimate:DiagramObject" id="visual-shared-a" fillColor="#ffffff" lineColor="#ff0000" fontColor="#000000" font="1|Segoe UI|9.0|1|WINDOWS|1|-15|0|0|0|700|0|0|0|0|3|2|1|34|Segoe UI" alpha="200" textAlignment="1" textPosition="1" archimateElement="element-shared" type="1">
        <bounds x="40" y="40" width="120" height="60"/>
        <feature name="labelExpression" value="${name}&#xA;${property:First}"/>
        <sourceConnection xsi:type="archimate:Connection" id="visual-relationship" fontColor="#0000ff" lineWidth="2" lineColor="#0000ff" source="visual-shared-a" target="visual-empty" archimateRelationship="relationship-serving"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="visual-shared-b" fillColor="#ffcccc" archimateElement="element-shared" type="0">
        <bounds x="200" y="40" width="120" height="60"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="visual-empty" archimateElement="element-empty">
        <bounds x="40" y="140" width="120" height="60"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="visual-grouping" textAlignment="1" archimateElement="element-grouping">
        <bounds x="200" y="140" width="120" height="60"/>
      </child>
      <child xsi:type="archimate:Note" id="visual-note" textAlignment="1">
        <bounds x="350" y="40" width="120" height="60"/>
        <content>Note content</content>
      </child>
    </element>
    <element xsi:type="archimate:ArchimateDiagramModel" name="Other View" id="view-other"/>
  </folder>
</archimate:model>
