---
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import rootPkg from '../../../package.json';
---

<footer class="sl-flex">
	<div class="meta sl-flex">
		<EditLink />
		<LastUpdated />
	</div>

	<div class="links">
		<a href="https://github.com/Continuous-DrivenArchitecture/archi-semantic-core">GitHub</a>
		<a href="https://www.npmjs.com/package/@cda/archi-semantic-core">npm</a>
		<a href="https://github.com/Continuous-DrivenArchitecture/archi-semantic-core/blob/develop/CHANGELOG.md">Changelog</a>
		<span class="version">v{rootPkg.version}</span>
	</div>

	<Pagination />
</footer>

<style>
	@layer starlight.core {
		footer {
			flex-direction: column;
			gap: 1.5rem;
		}
		.meta {
			gap: 0.75rem 3rem;
			justify-content: space-between;
			flex-wrap: wrap;
			margin-top: 3rem;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}
		.meta > :global(p:only-child) {
			margin-inline-start: auto;
		}
		.links {
			display: flex;
			align-items: baseline;
			flex-wrap: wrap;
			gap: 1.25rem;
			font-size: var(--sl-text-xs);
		}
		.links a {
			color: var(--sl-color-gray-3);
			text-decoration: none;
		}
		.links a:hover {
			color: var(--sl-color-white);
		}
		.links .version {
			color: var(--sl-color-gray-5);
		}
	}
</style>
